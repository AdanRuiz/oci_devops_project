#!/bin/bash

# Hey! If you're setting this up for the first time, follow these steps:
#
# 1. Copy this file: cp build-local.sh.template build-local.sh
#    (build-local.sh is gitignored so your credentials stay local)
#
# 2. We use a separate dev schema on the same ADB so local changes don't
#    touch production data. If TODOUSER_DEV doesn't exist yet on the DB,
#    go to OCI Console -> your ADB -> Database Actions -> SQL (as ADMIN) and run:
#
#        CREATE USER TODOUSER_DEV IDENTIFIED BY "pick-a-password";
#        GRANT CONNECT, RESOURCE TO TODOUSER_DEV;
#        GRANT UNLIMITED TABLESPACE TO TODOUSER_DEV;
#
#    Then use those credentials below. Ask Jozef if you need the ADB name/access.
#
# 3. Get the wallet: OCI Console -> ADB -> DB Connection -> Download Wallet
#    Unzip it and rename the folder to wallet-local, place it at backend/wallet-local/
#    Same wallet works for both prod and dev schemas.
#
# 4. Fill in your DB_PASSWORD and DB_URL below, then run: ./build-local.sh

export IMAGE_NAME=todolistapp-springboot
export IMAGE_VERSION=local

# Dev schema, keep this as TODOUSER_DEV, never use the prod TODOUSER here
DB_USER="TODOUSER_DEV"
DB_PASSWORD="YOUR_DEV_DB_PASSWORD"
DB_URL="URL_HERE"

mvn clean package spring-boot:repackage

docker build -f DockerfileDev \
  --build-arg WALLET_DIR=wallet-local \
  --build-arg DB_USER="${DB_USER}" \
  --build-arg DB_PASSWORD="${DB_PASSWORD}" \
  --build-arg DB_URL="${DB_URL}" \
  -t "${IMAGE_NAME}:${IMAGE_VERSION}" .

echo ""
echo "Build complete. Run locally with:"
echo "  docker stop todolistapp 2>/dev/null; docker rm todolistapp 2>/dev/null"
echo "  docker run -d --name todolistapp -p 8080:8080 ${IMAGE_NAME}:${IMAGE_VERSION}"
echo ""
echo "Then open: http://localhost:8080"
